{
  "name": "andresen-scholarships",
  "version": "1.0.0",
  "description": "Andresen Memorial Scholarships website + application system (Cloudflare Pages Functions, D1, R2, Resend).",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev .",
    "db:init:local": "wrangler d1 execute andresen-scholarships --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute andresen-scholarships --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute andresen-scholarships --local --file=./migrations/0002_board_review.sql",
    "db:migrate:remote": "wrangler d1 execute andresen-scholarships --remote --file=./migrations/0002_board_review.sql",
    "typecheck": "tsc --noEmit",
    "deploy": "git push origin scholarship-app"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.100.0"
  }
}
